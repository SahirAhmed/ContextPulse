<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_active_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- Dynamic Theme-based Rounded Card Background -->
    <ImageView
        android:id="@+id/widget_active_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Active Context Widget Background" />

    <LinearLayout
        android:id="@+id/widget_active_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Top Status Header Row (mirrors HomeScreen ActiveContextCard) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_active_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_active_status_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACTIVE CONTEXT"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_active_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_contextpulse_logo"
                android:contentDescription="ContextPulse Logo" />
        </LinearLayout>

        <!-- Vertically centered Context Name + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_active_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Active Context"
                android:textSize="17.5sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_active_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Default baseline state"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Live Active Context Duration Pill (Chronometer synced to persisted start time) -->
        <FrameLayout
            android:id="@+id/widget_active_timer_container"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_active_timer_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="Timer Background" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/widget_active_timer_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="5dp" />

                <Chronometer
                    android:id="@+id/widget_active_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
