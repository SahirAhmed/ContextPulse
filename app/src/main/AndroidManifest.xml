<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE Permissions (Android <= 11) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- BLE Permissions (Android 12+ API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- NFC Sensor Permissions -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Camera Permission for In-App QR Code Scanner -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Foreground Service & Execution Reliability -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- System Actions & Automation Testing Permissions -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Hardware requirements (set to required="false" for seamless emulator testing) -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Queries block for package inspection -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name="com.contextpulse.phase0.Phase0Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ContextPulsePhase0"
        tools:targetApi="35">

        <activity
            android:name="com.contextpulse.phase0.ui.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ContextPulsePhase0">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
            <!-- Android 10+ / 14 / 15: Configuration Activity for AutomaticZenRule -->
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
            </intent-filter>

            <!-- Android App Links with autoVerify for https://sahirahmed.github.io -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sahirahmed.github.io" />
                <data android:scheme="http" android:host="sahirahmed.github.io" />
            </intent-filter>

            <!-- Deep Link Intent Filters for Room QR Code triggers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="contextpulse" android:host="trigger" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sahir01ahmed.github.io" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="contextpulse.app" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.contextpulse.phase0.ui.StickyNoteOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.ContextPulse.TranslucentOverlay"
            android:taskAffinity="com.contextpulse.phase0.overlay"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasYellow"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_yellow"
            android:roundIcon="@mipmap/ic_launcher_yellow_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasRed"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red"
            android:roundIcon="@mipmap/ic_launcher_red_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:roundIcon="@mipmap/ic_launcher_blue_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_green"
            android:roundIcon="@mipmap/ic_launcher_green_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasPurple"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple"
            android:roundIcon="@mipmap/ic_launcher_purple_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasOrange"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orange"
            android:roundIcon="@mipmap/ic_launcher_orange_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasWhiteBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white_blue"
            android:roundIcon="@mipmap/ic_launcher_white_blue_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasWhiteBlack"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white_black"
            android:roundIcon="@mipmap/ic_launcher_white_black_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasWhiteEmerald"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white_emerald"
            android:roundIcon="@mipmap/ic_launcher_white_emerald_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasWhitePurple"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white_purple"
            android:roundIcon="@mipmap/ic_launcher_white_purple_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.contextpulse.phase0.ui.LauncherAliasWhiteCrimson"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white_crimson"
            android:roundIcon="@mipmap/ic_launcher_white_crimson_round"
            android:label="@string/app_name"
            android:targetActivity="com.contextpulse.phase0.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- App restriction overlay blocker activity -->
        <activity
            android:name="com.contextpulse.phase0.system.OverlayBlockerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleInstance" />

        <!-- Continuous BLE Scan & Room Detection Foreground Service -->
        <service
            android:name="com.contextpulse.phase0.ble.Phase0BleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Receiver for Scheduled Mode Timeframe Alarms -->
        <receiver
            android:name="com.contextpulse.phase0.system.ScheduleBoundaryReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Dynamic Floating Timer Overlay Service for Sleep & App Usage Limits -->
        <service
            android:name="com.contextpulse.phase0.system.FloatingTimerOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Optional Accessibility Service for comparative investigation of Test 5 & 6 -->
        <service
            android:name="com.contextpulse.phase0.system.AppInterceptorAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Boot Receiver for Auto-Start on phone restart & app update -->
        <receiver
            android:name="com.contextpulse.phase0.system.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Receiver for Clock, Timezone, and Date Changes -->
        <receiver
            android:name="com.contextpulse.phase0.system.TimeChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIME_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Receiver for Snooze Expiration Alarm -->
        <receiver
            android:name="com.contextpulse.phase0.system.SnoozeAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.contextpulse.phase0.system.ACTION_SNOOZE_EXPIRED" />
            </intent-filter>
        </receiver>

        <!-- ContextPulse AppWidget Provider -->
        <receiver
            android:name="com.contextpulse.phase0.widget.ContextPulseWidgetProvider"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.contextpulse.phase0.widget.ACTION_SWITCH_PROFILE" />
                <action android:name="com.contextpulse.phase0.widget.ACTION_REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/contextpulse_widget_info" />
        </receiver>

        <!-- Widget Configuration Activity -->
        <activity
            android:name="com.contextpulse.phase0.widget.ContextPulseWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.ContextPulsePhase0">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- FileProvider for Sharing and Printing Room QR Codes -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
